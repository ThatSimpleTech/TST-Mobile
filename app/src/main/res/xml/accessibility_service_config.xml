<?xml version="1.0" encoding="utf-8"?>
<!-- We are not an accessibility tool (isAccessibilityTool=false): apps may hide sensitive views
     from us, and we report that honestly instead of working around it (plan P7). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/a11y_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="100"
    android:settingsActivity="com.thatsimpletech.assist.ui.MainActivity" />
