<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="talk"
        android:enabled="true"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:shortcutShortLabel="@string/talk_short"
        android:shortcutLongLabel="@string/talk_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.thatsimpletech.assist"
            android:targetClass="com.thatsimpletech.assist.ui.MainActivity">
            <extra
                android:name="start_listen"
                android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
